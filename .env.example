# ============================================================================
# KERNEL SPACE CONFIGURATION ENVIRONMENT VARIABLES
# ============================================================================

# Supabase Project Credentials (required for live database persistence & auth)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-only Service Role Key (NEVER expose to client code or prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
